{
    "name": "justinholtweb/craft-library",
    "description": "A better media library for Craft CMS — collections, filters that work everywhere, bulk editing, usage tracking, duplicate detection and an alt text audit for your assets.",
    "type": "craft-plugin",
    "keywords": [
        "craftcms",
        "craft-plugin",
        "assets",
        "media-library",
        "digital-asset-management",
        "collections",
        "taxonomy",
        "bulk-edit",
        "duplicates",
        "accessibility"
    ],
    "license": "proprietary",
    "homepage": "https://justinholt.com/plugins/craft-library",
    "authors": [
        {
            "name": "Justin Holt",
            "homepage": "https://justinholt.com"
        }
    ],
    "support": {
        "email": "justin@justinholt.com",
        "docs": "https://justinholt.com/plugins/craft-library/docs",
        "source": "https://github.com/justinholtweb/craft-library",
        "issues": "https://github.com/justinholtweb/craft-library/issues"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "craftcms/cms": "^5.3.0"
    },
    "autoload": {
        "psr-4": {
            "justinholtweb\\library\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "justinholtweb\\library\\tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true
        },
        "sort-packages": true
    },
    "extra": {
        "name": "Library",
        "handle": "library",
        "developer": "Justin Holt",
        "developerUrl": "https://justinholt.com",
        "documentationUrl": "https://justinholt.com/plugins/craft-library/docs",
        "changelogUrl": "https://raw.githubusercontent.com/justinholtweb/craft-library/main/CHANGELOG.md",
        "class": "justinholtweb\\library\\Plugin",
        "editions": ["lite", "pro"]
    }
}
